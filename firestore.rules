rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isFarmer() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'farmer';
    }

    match /users/{uid} {
      allow read, create, update, delete: if isOwner(uid);

      match /cart/{productId} {
        allow read, write: if isOwner(uid);
      }

      match /favourites/{productId} {
        allow read, write: if isOwner(uid);
      }

      match /verification/{documentId} {
        allow read, write: if isOwner(uid);
      }

      match /earnings/{documentId} {
        allow read, write: if isOwner(uid) && isFarmer();
      }
    }

    match /products/{productId} {
      allow read: if signedIn();
      allow create: if isFarmer() && request.resource.data.farmerId == request.auth.uid;
      allow update, delete: if isFarmer() && resource.data.farmerId == request.auth.uid;
    }

    match /orders/{orderId} {
      allow create: if signedIn() && request.resource.data.buyerId == request.auth.uid;
      allow read: if signedIn() && (resource.data.buyerId == request.auth.uid || request.auth.uid in resource.data.farmerIds);
      allow update: if signedIn() && (resource.data.buyerId == request.auth.uid || request.auth.uid in resource.data.farmerIds);
      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow read, update: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants;
      allow delete: if false;
    }
  }
}
